# Bắt buộc: mật khẩu đăng nhập Cổng Quản Trị (kiểm tra phía server).
ADMIN_PASSWORD="doi-mat-khau-nay"
# Bắt buộc ở production: chuỗi ngẫu nhiên dài để ký phiên đăng nhập (openssl rand -hex 32).
SESSION_SECRET="doi-chuoi-ngau-nhien"

# Tùy chọn
SITE_URL=https://ten-mien-that.com   # tên miền công khai, dùng cho canonical/sitemap
DOMAIN=ten-mien-that.com   # dùng cho Caddy (HTTPS tự động)
PORT=3000
DATA_DIR=./data            # thư mục chứa database SQLite (cần lưu bền vững/backup)
SEED_DEMO=true             # true: nạp truyện mẫu khi DB trống. Đặt false khi chạy thật.
CRAWL_INTERVAL_MIN=0       # >0: tự quét chương mới mỗi N phút cho các truyện đã cấu hình crawler
TRUST_PROXY=1              # đặt khi chạy sau reverse proxy/Nginx (để giới hạn tốc độ theo IP đúng)
COOKIE_SECURE=true         # đặt false nếu chạy HTTP thuần (không HTTPS)
